# Copy to .env (local) or set in Vercel -> Project Settings -> Environment Variables
DEBUG=0
SECRET_KEY=change-me
ALLOWED_HOSTS=.vercel.app,localhost
# Neon: pooled string for the app, direct (unpooled) string for migrations
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
# Vercel Blob (private store). Leave empty locally to use the local-disk backend.
BLOB_READ_WRITE_TOKEN=
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me
